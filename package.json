{
  "name": "atual-mais-qa-automation",
  "version": "1.0.0",
  "description": "Testes automatizados (Playwright) do setor de QA - Projeto Atual Mais",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --grep-invert @api",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression --pass-with-no-tests",
    "test:card": "playwright test --grep",
    "test:api": "playwright test tests/api --project=chromium",
    "check:evidencias": "node tests/cards/check-evidencias.mjs",
    "limpar:titulos": "node scripts/limpar-titulos-teste.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.6"
  }
}
